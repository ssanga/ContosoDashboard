@if (Items == null)
{
    <p><em>Loading...</em></p>
}
else if (!Items.Any())
{
    <div class="alert alert-info" role="status">No documents found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Title</th>
                    <th scope="col">Category</th>
                    <th scope="col">Uploaded</th>
                    <th scope="col" class="text-end">Size</th>
                    <th scope="col">Project</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doc in Items)
                {
                    <tr>
                        <td>
                            <strong>@doc.Title</strong><br />
                            <small class="text-muted">@doc.OriginalFileName</small>
                        </td>
                        <td><span class="badge bg-secondary">@doc.Category</span></td>
                        <td>@doc.UploadedDate.ToLocalTime().ToString("g")</td>
                        <td class="text-end">@FormatSize(doc.FileSize)</td>
                        <td>@(doc.ProjectName ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter] public IEnumerable<DocumentSummary>? Items { get; set; }

    private static string FormatSize(long bytes)
    {
        if (bytes >= 1024 * 1024) return $"{bytes / (1024.0 * 1024.0):0.#} MB";
        if (bytes >= 1024) return $"{bytes / 1024.0:0.#} KB";
        return $"{bytes} B";
    }
}
